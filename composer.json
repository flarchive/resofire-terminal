{
    "name": "resofire/terminal",
    "description": "Terminal — a monospace dark theme for Flarum 2.x",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "resofire"
        }
    ],
    "require": {
        "flarum/core": "^2.0"
    },
    "extra": {
        "flarum-extension": {
